{
  "_doc": "Octane classifier rules for the Israeli vehicle registry. Rules eval top-to-bottom; first match wins. Rules with skip_if_cosmetic=true are skipped when the cosmetic guard fires (S-Line/AMG-Line/R-Line/etc.). LIKE pattern % = any chars, _ = single char.\n\nBUCKET RULE (Israel sells only 95 and 98 RON, so bucket by the manufacturer's MINIMUM):\n  min_ron >= 96  -> \"98\"   (95 is below the stated minimum; e.g. US 'premium 91 AKI' = RON 96, or EU '98 required')\n  rec_ron >= 96  -> \"rec\"  (95 is acceptable, 98 recommended for full output)\n  otherwise      -> \"95\"\n`min_ron` / `rec_ron` are the input; `then` must equal what they imply (checked by rules_impact.py --check). `source` records the document the numbers come from. The Israeli importer spec sheet wins over the export manual: \"fuel type required: 98\" -> 98, \"fuel type recommended: 98\" -> rec.",
  "engine_sets": {
    "AUDI_NA": [
      "ALT",
      "BSE",
      "BGU",
      "BYT",
      "BVY",
      "BLR",
      "AUK",
      "CAL",
      "BDW",
      "BDV",
      "BDX",
      "BHK",
      "ASN",
      "ADR",
      "AGN"
    ],
    "AUDI_R8": [
      "BYH",
      "BUJ",
      "CND"
    ],
    "CHEV_REC": [
      "LTG",
      "LSY",
      "L87",
      "L86"
    ],
    "CHEV_98": [
      "LT1",
      "LT4",
      "LT2",
      "LT6",
      "LS1",
      "LS2",
      "LS3",
      "LS6",
      "LS7",
      "LS9",
      "LSA",
      "L99",
      "LT5"
    ]
  },
  "brand_aliases": {
    "אודי": "אאודי",
    "מזארטי": "מזראטי",
    "ביסמרק": "ב מ וו",
    "אייטס": "מרצדס",
    "ג'ון וו": "פורשה",
    "קוגל": "אלפא",
    "צפל": "ג'יפ",
    "אחרי נגררי שטח": "ג'יפ",
    "וי.די.ל.": "דונקרוורת",
    "סטרה": "אופל"
  },
  "cosmetic": {
    "name": [
      "%S LINE%",
      "%S-LINE%",
      "%N LINE%",
      "%N-LINE%",
      "%R LINE%",
      "%R-LINE%",
      "%GT LINE%",
      "%GT-LINE%",
      "%ST LINE%",
      "%ST-LINE%",
      "%M SPORT%",
      "%M-SPORT%",
      "%AMG LINE%",
      "%GR SPORT%",
      "%GR-SPORT%",
      "%SPORT LINE%",
      "%F SPORT%",
      "%F-SPORT%",
      "%OPC LINE%",
      "%OPC-LINE%"
    ],
    "trim": [
      "%S LINE%",
      "%N LINE%",
      "%N-LINE%",
      "%R LINE%",
      "%R-LINE%",
      "%GT LINE%",
      "%ST LINE%",
      "%M SPORT%",
      "%AMG LINE%",
      "%GR SPORT%",
      "%SPORT LINE%",
      "%F SPORT%",
      "%F-SPORT%",
      "%OPC LINE%",
      "%OPC-LINE%"
    ]
  },
  "rules": [
    {
      "id": "exotic-brands",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "פורשה",
          "פרארי",
          "למבורגיני",
          "אסטון",
          "בנטלי",
          "רולס",
          "מזראטי",
          "מזארטי",
          "מקלא",
          "מקלר",
          "לוטוס",
          "אלפיין",
          "אלפין"
        ]
      },
      "then": "98",
      "min_ron": 98,
      "source": "exotic/track cars, 98-grade",
      "note": "Exotic brands always require premium"
    },
    {
      "id": "mercedes-amg",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "מרצדס"
        ],
        "name": [
          "AMG%",
          "% AMG%",
          "%AMG %"
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "Mercedes-AMG owner's manual: 'For maximum engine output ... at least 98 RON. Alternatively ... at least 95 RON'. The Israeli AMG spec sheets (GLC 53, SL 43/55/63, C43 - checked mechanically) contain NO fuel/octane statement, so the manual is the source of record",
      "note": "all AMG: 95 RON permitted, 98 for full output"
    },
    {
      "id": "daimlerchrysler-amg",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "דימלרקריזלר",
          "דימלר בנץ",
          "דימלר-בנץ"
        ],
        "name": [
          "%AMG%"
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "DaimlerChrysler-era AMG (M113/M156, 55/63): 98 RON for max output, 95 permitted (same AMG wording)",
      "note": "brand strings widened: the registry uses 'דימלר בנץ' (verified via rules_coverage.py - the rule never fired)"
    },
    {
      "id": "bmw-m",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "ב מ וו"
        ],
        "any": [
          {
            "name": [
              "M2%",
              "M3%",
              "M4%",
              "M5%",
              "M6%",
              "M8%",
              "%M135%",
              "%M140%",
              "%M235%",
              "%M240%",
              "%M340%",
              "%M440%",
              "%M550%",
              "%M850%",
              "%M35I%",
              "%M40I%",
              "%M50I%",
              "%M50",
              "%M60I%",
              "%X3 M%",
              "%X4 M%",
              "%X5 M%",
              "%X6 M%",
              "%Z4 M%"
            ]
          },
          {
            "engine_starts_with": [
              "S55",
              "S58",
              "S63",
              "S65",
              "S85",
              "S54",
              "S62",
              "S70",
              "N55",
              "B58"
            ]
          }
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "BMW M: figures apply 'using RON 98 fuel'; IL M4 spec sheet: '98 unleaded (recommended)'; M-Performance (M135i/M140i/M235i/M240i/M440i) is 95 RON min",
      "note": "full M and M-Performance: 95 RON permitted, 98 recommended (was 98). Engine paths added for imports"
    },
    {
      "id": "audi-rs-r8-name",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "אאודי"
        ],
        "name": [
          "RS%",
          "%RS3%",
          "%RS4%",
          "%RS5%",
          "%RS6%",
          "%RS7%",
          "%RSQ%",
          "R8%",
          "TT RS%"
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "Audi: 98 RON recommended, 95 RON permitted",
      "note": "was 98"
    },
    {
      "id": "audi-r8-engine",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "אאודי"
        ],
        "engine_set": "AUDI_R8"
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "Audi R8 V10: 98 recommended, 95 permitted",
      "note": "was 98"
    },
    {
      "id": "vw-golf-r",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "פולקסווגן"
        ],
        "any": [
          {
            "name": [
              "GOLF R%"
            ]
          },
          {
            "trim": [
              "%GOLF R%"
            ]
          },
          {
            "all": [
              {
                "name": [
                  "GOLF",
                  "GOLF 3DR",
                  "GOLF 5DR"
                ]
              },
              {
                "trim": [
                  "R",
                  "R PERFORMANCE",
                  "R BLACK ED",
                  "R PLUS",
                  "R PERFORMANCE%",
                  "R BLACK%"
                ]
              }
            ]
          }
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "Golf R Mk7 manual: 'minimum 91 AKI (95 RON)'; VW MY26 spec sheet: 'Fuel type (Recommended): Premium unleaded 98 RON'; VW USA: 'Premium unleaded recommended'",
      "note": "unchanged: 95 RON permitted, 98 recommended. The 'minimum 98' figure seen for the Mk8 was the AU spec sheet's *recommended* field"
    },
    {
      "id": "honda-type-r",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "הונדה"
        ],
        "any": [
          {
            "name_or_trim": [
              "%TYPE R%",
              "%TYPE-R%"
            ]
          },
          {
            "engine_starts_with": [
              "K20C"
            ]
          }
        ]
      },
      "then": "98",
      "min_ron": 98,
      "source": "IL importer spec sheets: Civic Type R FK8 (2017) 'fuel type REQUIRED: 98'; FL5 (2023) 'fuel type (recommended): 98'. FUEL REQUIRED/נדרש on the earlier car",
      "note": "stays 98: the FK8 requires it and the FL5 recommends it; the classifier has no model year, so one bucket covers both"
    },
    {
      "id": "honda-acura-type-s",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "הונדה",
          "אקורה"
        ],
        "name_or_trim": [
          "%TYPE S%",
          "%TYPE-S%"
        ]
      },
      "then": "98",
      "min_ron": 96,
      "source": "Acura Type S (3.0T): US premium 91 AKI (RON 96)",
      "note": "was rec"
    },
    {
      "id": "hyundai-n",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "יונדאי"
        ],
        "any": [
          {
            "name": [
              "% N",
              "% N %"
            ]
          },
          {
            "engine_eq": "G4KH"
          },
          {
            "engine_eq": "G4FV"
          }
        ]
      },
      "then": "rec",
      "min_ron": 95,
      "rec_ron": 98,
      "source": "i30 N owner's manual (UK/AU): 'minimum RON 95 (AKI 91) ... dropping below risks reduced power and potential engine damage'; Elantra N (US): min 87 AKI, premium 91 AKI (RON 95) recommended",
      "note": "confirmed rec: min 95, no 98 requirement"
    },
    {
      "id": "toyota-gr-supra-86",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "טויוטה"
        ],
        "any": [
          {
            "name": [
              "GR %",
              "%GR86%",
              "%GR 86%",
              "%SUPRA%",
              "86",
              "TOYOTA 86%"
            ]
          },
          {
            "engine_starts_with": [
              "G16E",
              "B58",
              "FA20",
              "FA24",
              "2JZ"
            ]
          }
        ]
      },
      "then": "98",
      "min_ron": 98,
      "source": "GT86/GR86 (FA20/FA24 12.5:1) local requirement 98; GR models 98-grade",
      "note": "engine paths added for imports (GR Yaris/Corolla G16E, Supra B58/2JZ, 86 FA20/FA24)"
    },
    {
      "id": "ford-perf",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "פורד"
        ]
      },
      "then": [
        {
          "when": {
            "name": [
              "%FOCUS RS%",
              "%SHELBY%",
              "%GT350%",
              "%GT500%",
              "%MACH 1%",
              "%MACH1%",
              "%BULLITT%",
              "%BOSS 302%",
              "%FORD GT%"
            ]
          },
          "then": "98",
          "min_ron": 96,
          "source": "US premium 91 AKI (RON 96)"
        },
        {
          "when": {
            "name": [
              "%MUSTANG%"
            ]
          },
          "then": [
            {
              "when": {
                "name_or_trim_not": [
                  "%ECOBOOST%",
                  "%ECOBOST%",
                  "%ECO BOOST%",
                  "%EBOOST%",
                  "%EBOST%"
                ],
                "name_or_trim": [
                  "%GT%"
                ]
              },
              "then": "98",
              "min_ron": 96,
              "source": "Mustang GT (Coyote V8): US premium 91 AKI"
            },
            {
              "then": "rec",
              "min_ron": 95,
              "rec_ron": 98,
              "source": "Mustang EcoBoost: 95 RON min"
            }
          ]
        },
        {
          "when": {
            "name_or_trim": [
              "% ST",
              "% ST %",
              "%-ST",
              "%FIESTA ST%",
              "%FOCUS ST%",
              "%PUMA ST%"
            ]
          },
          "then": "rec",
          "min_ron": 95,
          "rec_ron": 98,
          "source": "Ford ST (EU): 95 RON min, 98 recommended"
        }
      ],
      "min_ron": 96,
      "source": "US premium-spec (91 AKI = RON 96) for Focus RS / Shelby / GT350 / GT500 / Mach 1 / Bullitt / Boss 302 / Ford GT / Mustang GT; EU ST models 95 RON min"
    },
    {
      "id": "bmw-mini-jcw",
      "skip_if_cosmetic": true,
      "when": {
