      "rec_ron": 98,
      "source": "EU-spec 1.4 T-Jet: RON 95 min",
      "note": "Abarth 1.4 T-Jet: 98 recommended, 95 OK (like Cupra)"
    },
    {
      "id": "viper-name",
      "skip_if_cosmetic": true,
