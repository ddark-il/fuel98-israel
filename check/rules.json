    "AUDI_NA": [
      "ALT",
      "BSE",
      "BGU",
      "BYT",
      "BVY",
      "BLR",
      "AUK",
      "CAL",
      "BDW",
      "BDV",
      "BDX",
      "BHK",
      "ASN",
      "ADR",
      "AGN"
    ],
    "AUDI_R8": [
      "BYH",
      "BUJ",
      "CND"
    ],
    "CHEV_REC": [
      "LTG",
      "LSY",
      "L87",
      "L86"
    ],
    "CHEV_98": [
      "LT1",
      "LT4",
      "LT2",
      "LT6",
      "LS1",
      "LS2",
      "LS3",
      "LS6",
      "LS7",
      "LS9",
      "LSA",
      "L99",
      "LT5"
    ]
  },
  "brand_aliases": {
    "אודי": "אאודי",
    "מזארטי": "מזראטי",
    "ביסמרק": "ב מ וו",
    "אייטס": "מרצדס",
    "ג'ון וו": "פורשה",
    "קוגל": "אלפא",
    "צפל": "ג'יפ",
    "אחרי נגררי שטח": "ג'יפ",
    "וי.די.ל.": "דונקרוורת",
    "סטרה": "אופל"
  },
  "cosmetic": {
    "name": [
      "%S LINE%",
      "%S-LINE%",
      "%N LINE%",
      "%N-LINE%",
      "%R LINE%",
      "%R-LINE%",
      "%GT LINE%",
      "%GT-LINE%",
      "%ST LINE%",
      "%ST-LINE%",
      "%M SPORT%",
      "%M-SPORT%",
      "%AMG LINE%",
      "%GR SPORT%",
      "%GR-SPORT%",
      "%SPORT LINE%",
      "%F SPORT%",
      "%F-SPORT%",
      "%OPC LINE%",
      "%OPC-LINE%"
    ],
    "trim": [
      "%S LINE%",
      "%N LINE%",
      "%N-LINE%",
      "%R LINE%",
      "%R-LINE%",
      "%GT LINE%",
      "%ST LINE%",
      "%M SPORT%",
      "%AMG LINE%",
      "%GR SPORT%",
      "%SPORT LINE%",
      "%F SPORT%",
      "%F-SPORT%",
      "%OPC LINE%",
      "%OPC-LINE%"
    ]
  },
  "rules": [
    {
      "id": "exotic-brands",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "פורשה",
          "פרארי",
          "למבורגיני",
          "אסטון",
          "בנטלי",
          "רולס",
          "מזראטי",
          "מזארטי",
          "מקלא",
          "מקלר",
          "לוטוס",
          "אלפיין",
          "אלפין"
        ]
      },
      "then": "98",
      "note": "Exotic brands always require premium"
    },
    {
      "id": "mercedes-amg",
      "skip_if_cosmetic": true,
      "when": {
        "brand": [
          "מרצדס"
        ],
        "name": [
          "AMG%",
          "% AMG%",
          "%AMG %"
        ]
      },
      "then": [
        {
          "when": {
            "name": [
              "%35%",
              "%43%",
              "%53%"
            ]
          },
          "then": "rec",
          "note": "AMG 35/43/53 entry/mid (2.0T / 3.0 I6)"
        },
        {
          "then": "98",
          "note": "AMG 45/63/GT/V8"
        }
      ]
    },
    {
